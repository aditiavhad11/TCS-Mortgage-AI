APP_NAME=TCS Mortgage AI
ENVIRONMENT=development
DATABASE_URL=sqlite:///./mortgage.db
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"  (>= 32 chars is REQUIRED when ENVIRONMENT != development)
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=60
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_EXPIRY_MINUTES=30
MAX_UPLOAD_SIZE_MB=15
UPLOADS_DIR=./private_uploads
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe  (leave empty if tesseract is on PATH)
TESSERACT_CMD=
OCR_MAX_PAGES=30
# --- NVIDIA (keep ONLY in backend/.env, never in the frontend) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Must be a model your key can call. Confirm with: python scripts/verify_nvidia.py
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
# true = skip model reasoning for fast (seconds) document analysis; set false if your endpoint rejects it
NEMOTRON_DISABLE_THINKING=true
NVIDIA_TIMEOUT_SECONDS=45
NEMOTRON_MAX_INPUT_CHARS=24000
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# --- Password hashing: PBKDF2-HMAC-SHA256. Production requires >= 210000 (OWASP 2023 recommends 600000).
PBKDF2_ITERATIONS=600000

# --- Platform Admin sign-in uses email OTP only. INITIAL_ADMIN_EMAIL is the sole authorized address.
# Development without SMTP: the code is printed to the backend console. Other environments require SMTP.
ADMIN_OTP_REQUIRED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# SMTP_USER is also accepted as an alias for SMTP_USERNAME.
SMTP_PASSWORD=
SMTP_FROM=
# false = STARTTLS (port 587); true = implicit TLS (usually port 465)
SMTP_USE_SSL=false
# --- To receive OTPs by real email (example: Gmail) ---
# 1. Google Account -> Security -> turn on 2-Step Verification -> App passwords -> create one.
# 2. Fill in (no quotes):  SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USERNAME=you@gmail.com
#    SMTP_PASSWORD=<16-char app password>  SMTP_FROM=you@gmail.com
# SMTP_FROM must be accepted by your provider; Gmail requires the authenticated address or a verified send-as alias.
# 3. Restart the backend, then verify:  python scripts/test_smtp.py you@gmail.com
# Link used in emailed Bank Admin invitations:
FRONTEND_BASE_URL=http://localhost:5173

# Set INITIAL_ADMIN_EMAIL in backend/.env. The backend provisions this address; there is no public admin registration.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=

# Deterministic numerical comparison tolerance; not a credit eligibility threshold.
FINANCIAL_TOLERANCE_PERCENT=2.0

# Seconds between background retries of applications awaiting reviewer assignment (0 disables).
ASSIGNMENT_RETRY_INTERVAL_SECONDS=60
